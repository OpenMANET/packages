#!/bin/sh

# HaLow Link 2 (morse,artini) wireless defaults:
# - Use the correct HL2 BCF (bcf_mm_hl2_ext.bin) with proper calibration
#   for the mm8108-mf15457 module (not the HL1's AW-HM593 BCF)
# - Set default channel 28 (916 MHz, 8 MHz BW)

. /lib/functions.sh

case "$(board_name)" in
morse,artini)
	for radio in $(uci -q show wireless | grep "=wifi-device" | cut -d. -f2 | cut -d= -f1); do
		type=$(uci -q get wireless.$radio.type)
		if [ "$type" = "morse" ]; then
			uci -q set wireless.$radio.channel=28
			uci -q set wireless.$radio.bcf='bcf_mm_hl2_ext.bin'
		fi
	done

	uci -q commit wireless
	;;
esac
