#!/bin/sh
# netifd sees vxlan as a single interface instead of a interface with a device component.
# The result of this is that the bridge isn’t restarted along with the vxlan interface breaking vxlan.

# Load OpenWrt helper functions
. /lib/functions.sh

# Configuration
VXLAN_INTERFACE="vxlan0"
BRIDGE_INTERFACE="tailscale0"

# Exit early if not monitoring this interface
[ "$INTERFACE" = "$VXLAN_INTERFACE" ] || exit 0

# Handle interface state changes
case "$ACTION" in
	ifup)
		logger -t hotplug "Bringing up $BRIDGE_INTERFACE since $VXLAN_INTERFACE is up"
		ifup "$BRIDGE_INTERFACE"
		;;
	ifdown)
		logger -t hotplug "Taking down $BRIDGE_INTERFACE since $VXLAN_INTERFACE is down"
		ifdown "$BRIDGE_INTERFACE"
		;;
esac

exit 0
