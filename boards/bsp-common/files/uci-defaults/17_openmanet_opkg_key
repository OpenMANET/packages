#!/bin/sh

# Trust the OpenMANET package repository signing key. Written at runtime
# instead of packaged so it never clashes with the copy base-files installs
# in signed release builds.
mkdir -p /etc/opkg/keys
cat > /etc/opkg/keys/a0e0dd4a324a953d << 'EOF'
untrusted comment: OpenMANET packages public key
RWSg4N1KMkqVPeTS+1YUelNvIGHb7IGB6cnl6gfQzSuktHB68ExPRwfp
EOF
