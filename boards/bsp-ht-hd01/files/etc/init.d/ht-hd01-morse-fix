#!/bin/sh /etc/rc.common

START=08

boot() {
	# Patch chipreset.sh for libgpiod v2 compatibility (gpiofind removed in v2)
	# Must run before morsechipreset (START=09)
	if [ -f /morse/scripts/chipreset.sh ] && ! command -v gpiofind >/dev/null 2>&1; then
		sed -i 's/gpiofind MM_RESET/echo MM_RESET/' /morse/scripts/chipreset.sh
		sed -i 's/gpioset -m time -u 50000/gpioset -t 50ms,0/' /morse/scripts/chipreset.sh
		sed -i 's/sleep 0\.05/sleep 1/' /morse/scripts/chipreset.sh
	fi

	# Disable morsechipreset — its unbind+reset+rebind doesn't work on kernel 6.6
	[ -f /etc/init.d/morsechipreset ] && /etc/init.d/morsechipreset disable 2>/dev/null

	# Stock firmware loads mtk-sd AFTER chipreset. Our build loads it at
	# boot time (modules-boot.d) before init scripts. Fix the order:
	rm -f /etc/modules-boot.d/sdhci-mt7620 2>/dev/null

	if grep -q mtk_sd /proc/modules 2>/dev/null; then
		rmmod mtk_sd 2>/dev/null
		sleep 1
	fi

	# Power on and reset MM6108
	gpioset -t0 MM_WAKE=1 2>/dev/null
	gpioset -t 50ms,0 MM_RESET=0 2>/dev/null
	gpioget MM_RESET >/dev/null 2>&1
	sleep 1

	# mtk-sd reloaded by kmodloader from modules.d at START=10
}

start() {
	# Fix for kernel 6.6 mac80211 limitation: Morse driver doesn't expose MFP capabilities
	# for mesh networks, which causes SAE auth to fail. Set ieee80211w=0 for mesh mode
	# and ieee80211w=2 for other modes (AP). Also set sae_pwe=0 for compatibility.

	[ -f /lib/netifd/morse/morse_overrides.sh ] || return 0

	sed -i 's/"set_default sae_pwe 1"/"set_default sae_pwe 0"/g' /lib/netifd/morse/morse_overrides.sh
	sed -i 's/set_default ieee80211w 2/[ "$mode" = mesh ] \&\& set_default ieee80211w 0 || set_default ieee80211w 2/g' /lib/netifd/morse/morse_overrides.sh
}
