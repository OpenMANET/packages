#!/bin/sh
# Heltec HT-HD01 board defaults: channel 28 (916 MHz, 8 MHz BW), BCF, and LED

. /lib/functions.sh

set_ht_hd01_defaults() {
	local config="$1"
	local type

	config_get type "$config" type
	[ "morse" = "$type" ] || return 0

	uci -q set wireless."${config}".channel='28'
	uci -q set wireless."${config}".bcf='bcf_mf08551.bin'
}

board=$(board_name)
[ "$board" = "heltec,ht-hd01-v1" ] || exit 0

config_load wireless
config_foreach set_ht_hd01_defaults wifi-device
uci commit wireless

# Configure status LED
uci batch <<'EOF'
set system.led_status=led
set system.led_status.sysfs='fuchsia:status'
set system.led_status.trigger='default-on'
set system.led_status.default='1'
EOF
uci commit system
