#!/bin/sh /etc/rc.common

START=08

. /lib/functions.sh

# Neuter morse-bundle's morsechipreset (START=09) on BCM2710.
#
# The libgpiod v2 version of chipreset.sh unbinds the first mmc_host before
# checking for the MM_RESET GPIO line name. BCM2710 images do not define that
# line name, so the script exits before rebinding the controller. If the first
# host is the boot SD controller, the root SquashFS becomes unreadable.
#
# Firmware 1.7.1 checked for MM_RESET before unbinding MMC and therefore
# skipped the reset safely on BCM2710. This guard restores that behavior
# without adding board-specific GPIO line names.
#
# This must run before morsechipreset during the same boot. Removing its S09
# symlink alone is insufficient because procd constructs the boot list up
# front, so replace the helper that the already-queued service will execute.

boot() {
	case "$(board_name)" in
	bcm2710,*)
		if [ -f /morse/scripts/chipreset.sh ] && \
		   ! grep -q "Disabled on BCM2710" /morse/scripts/chipreset.sh; then
			cat <<'EOF' > /morse/scripts/chipreset.sh
#!/bin/sh
# Disabled on BCM2710 by bsp-bcm271x: the vendor reset helper can unbind
# the boot SD controller before discovering that MM_RESET is unavailable.
exit 0
EOF
			chmod 755 /morse/scripts/chipreset.sh
		fi

		# Keep subsequent boots from scheduling the unnecessary service.
		rm -f /etc/rc.d/S??morsechipreset
		;;
	esac
}
