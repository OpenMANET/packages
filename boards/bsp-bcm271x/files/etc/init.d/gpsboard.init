#!/bin/sh /etc/rc.common
START=21

USE_PROCD=1
NAME=init-gps-device

# WM1302 Pi HAT + Quectel L76K(B)
GPIO_RST=25       # GPS_RST (active high pulse)
GPIO_WAKE=12      # GPS_WAKE_UP (high = standby, low = active)
DT_PATH=/proc/device-tree
HAT_DT_PATH=$DT_PATH/hat

boot() {
    device=$(get_gpsd_device)
    if [ $? -ne 0 ] || [ -z "$device" ]; then
        logger -t "$NAME" "WARNING: GPS device not configured in /etc/config/gpsd"
        device=""
    else
        logger -t "$NAME" "GPS device: $device"
    fi

    local board enabled
    board=$(uci -q get gpsd.core.board)
    enabled=$(uci -q get gpsd.core.enabled)
    [ "$enabled" != "0" ] || return 0
    # Raven has its own GPIO initialization; other SoCs use their own BSP.
    if ! supported_pi; then
        logger -t "$NAME" "GPS GPIO setup skipped: not a supported non-Raven Raspberry Pi"
        return 0
    fi
    case "$board" in
        auto|"")
            # Supported SPI profiles and non-Raven Pi 4/CM4 carriers assume
            # Seeed wiring even when the HAT has no programmed EEPROM.
            if ! detect_wm1302 && ! spi_profile && ! pi4_or_cm4; then
                logger -t "$NAME" "No Seeed GPS carrier detected or assumed; GPS GPIOs untouched"
                return 0
            fi
            board=wm1302
            ;;
        wm1302) ;;
        none)
            logger -t "$NAME" "GPS GPIO initialization disabled (gpsd.core.board=$board)"
            return 0
            ;;
        *)
            logger -t "$NAME" "ERROR: unsupported GPS board '$board'"
            return 1
            ;;
    esac
    [ "$device" = "/dev/ttyAMA0" ] || {
        logger -t "$NAME" "ERROR: WM1302 requires gpsd.core.device=/dev/ttyAMA0"
        return 1
    }
    logger -t "$NAME" "GPS carrier: $board (Seeed wiring)"
    # Initialize the GPS GPIOs and reset the module
    init_gps_gpio

    exit 0
}

supported_pi() {
    local name
    name=$(board_name)
    if [ -r "$DT_PATH/sysinfo-board-name" ]; then
        name="$name $(tr -d '\000' < "$DT_PATH/sysinfo-board-name")"
    fi
    name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
    case "$name" in *raven*) return 1;; esac
    tr '\000' '\n' < "$DT_PATH/compatible" 2>/dev/null | grep -q '^raspberrypi,'
}

pi4_or_cm4() {
    tr '\000' '\n' < "$DT_PATH/compatible" 2>/dev/null |
        grep -Eq '^raspberrypi,4-(model-b|compute-module)$'
}

spi_profile() {
    case "$(board_name)" in
        bcm2710,mm*-spi|bcm2711,mm*-spi|bcm2712,mm*-spi|morse,*-spi) return 0;;
    esac
    # The firmware's SPI overlay supplies this marker, including when the
    # radio has not probed yet. A USB or SDIO profile does not supply it.
    find "$DT_PATH" -name openmanet,wm6108-reset -print -quit 2>/dev/null | grep -q .
}

# EEPROM identity remains sufficient on other supported Raspberry Pi profiles.
detect_wm1302() {
    local vendor product
    [ -r "$HAT_DT_PATH/vendor" ] && [ -r "$HAT_DT_PATH/product" ] || return 1
    vendor=$(tr -d '\000' < "$HAT_DT_PATH/vendor" | tr '[:upper:]' '[:lower:]')
    product=$(tr -d '\000' < "$HAT_DT_PATH/product" | tr '[:upper:]' '[:lower:]')
    case "$vendor" in *seeed*) ;; *) return 1;; esac
    printf '%s\n' "$product" | grep -Eq '(^|[^a-z0-9])wm1302([^a-z0-9]|$)'
}

set_gpio_persistent() {
    local gpio="$1"
    local value="$2"
    # Use gpioset with daemonize to persist GPIO state
    # -c gpiochip0: specify the chip (GPIOs 0-57 are on gpiochip0)
    # -C: set consumer name for identification in gpioinfo
    # -z: daemonize to keep GPIO state after exit (no & needed)
    gpioset -c gpiochip0 -C "gps-wm1302" -z "${gpio}=${value}" 2>/dev/null
}

get_gpio_val() {
    local gpio="$1"
    gpioget -c gpiochip0 "${gpio}" 2>/dev/null || echo "?"
}

get_gpsd_device() {
    local device
    device=$(uci -q get gpsd.core.device)
    if [ -n "$device" ]; then
        echo "$device"
        return 0
    else
        return 1
    fi
}

init_gps_gpio() {
    logger -t "$NAME" "configuring GPS GPIOs (RST=${GPIO_RST}, WAKE=${GPIO_WAKE})"

    # Kill any existing gpioset processes for these pins
    pkill -f "gpioset.*${GPIO_RST}=" 2>/dev/null || true
    pkill -f "gpioset.*${GPIO_WAKE}=" 2>/dev/null || true

    # Set WAKE low (active) - persistent
    set_gpio_persistent "$GPIO_WAKE" 0

    # Reset pulse sequence: set low, pulse high, then back to low
    set_gpio_persistent "$GPIO_RST" 0
    sleep 1

    logger -t "$NAME" "pulsing GPS reset on GPIO${GPIO_RST}"
    # Kill the persistent low, set high, then set low persistent again
    pkill -f "gpioset.*${GPIO_RST}=" 2>/dev/null || true
    set_gpio_persistent "$GPIO_RST" 1
    sleep 1
    pkill -f "gpioset.*${GPIO_RST}=" 2>/dev/null || true
    set_gpio_persistent "$GPIO_RST" 0

    # Small Delay for Initialization
    sleep 1

    logger -t "$NAME" "GPIO states:"
    logger -t "$NAME" "  GPIO${GPIO_RST} (RST)     = $(get_gpio_val ${GPIO_RST})"
    logger -t "$NAME" "  GPIO${GPIO_WAKE} (WAKEUP) = $(get_gpio_val ${GPIO_WAKE})"
}
