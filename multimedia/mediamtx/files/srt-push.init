#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=9

start_service() {
	local enabled path destination listener
	config_load cameras
	config_get_bool enabled luci push_enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get destination luci push_destination
	config_get path luci push_path
	[ -n "$destination" ] || return 0
	if [ -z "$path" ]; then
		config_load camera-onvif-server
		config_get path rpicamera rtsp_name rpicamera
	fi
	listener="$(uci -q get 'mediamtx.@mediamtx[0].srt_address')"
	procd_open_instance
	procd_set_param command /usr/bin/mediamtx srt-push
	procd_set_param env "SRT_LISTENER=${listener:-:8890}" "SRT_PATH=${path#/}" "SRT_DESTINATION=$destination"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cameras mediamtx camera-onvif-server
}
