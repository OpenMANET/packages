#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=9

start_push() {
	local enabled path destination listener
	config_load openmanet_video
	config_get_bool enabled playback push_enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get destination playback push_destination
	config_get path playback push_path
	[ -n "$destination" ] || return 0
	if [ -z "$path" ]; then
		config_load camera-onvif-server
		config_get path rpicamera rtsp_name rpicamera
	fi
	listener="$(uci -q get 'mediamtx.@mediamtx[0].srt_address')"
	procd_open_instance
	procd_set_param command /usr/bin/mediamtx srt-push
	procd_set_param env "SRT_LISTENER=${listener:-:8890}" "SRT_PATH=${path#/}" "SRT_DESTINATION=$destination"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

start_adaptive() {
	local enabled transport path addr port floor ceiling
	config_load openmanet_video
	config_get_bool enabled playback adaptive_bitrate 0
	config_get transport playback transport srt
	[ "$enabled" = 1 ] && [ "$transport" = srt ] || return 0
	config_get floor playback adaptive_min_kbps 125
	config_get ceiling playback adaptive_max_kbps 1100
	config_load camera-onvif-server
	config_get path rpicamera rtsp_name rpicamera
	addr="$(uci -q get 'mediamtx.@mediamtx[0].api_address')"
	port="${addr##*:}"
	procd_open_instance adaptive
	procd_set_param command /usr/bin/openmanet-videorate -rpicamera -managed-camera -iface auto \
		-api "127.0.0.1:${port:-9997}" -path "${path#/}" -min "$floor" -max "$ceiling" \
		-start "$ceiling" -status /var/run/openmanet-videorate.json
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	start_push
	start_adaptive
}

service_triggers() {
	procd_add_reload_trigger openmanet_video mediamtx camera-onvif-server
}
