#!/bin/sh /etc/rc.common
# Copyright (C) 2009-2011 OpenWrt.org
START=50

USE_PROCD=1
PROG=/usr/sbin/gpsd
NAME=gpsd

validate_section_gpsd()
{
	uci_load_validate gpsd gpsd "$1" "$2" \
		'enabled:bool:1' \
		'device:string' \
		'listen_globally:bool:0' \
		'port:port:2947'
}

gpsd_instance()
{
	[ "$2" = 0 ] || {
		echo "validation failed"
		return 1
	}

	[ "$enabled" = "0" ] && return 1

	procd_open_instance
	# -F: control socket keeps gpsd alive (and retrying the device on each
	# client WATCH) when the initial device open fails at boot; without it
	# gpsd exits fatally ("can't run with neither control socket nor
	# devices open")
	procd_set_param command "$PROG" -N -n -F /var/run/gpsd.sock

	[ "$listen_globally" -ne 0 ] && procd_append_param command -G
	procd_append_param command -S "$port"
	procd_append_param command "$device"
	# retry=0: respawn forever so gpsd recovers once the GPS UART is ready,
	# instead of procd giving up after 5 attempts
	procd_set_param respawn 3600 5 0
	# gpsd -N logs to stderr only; without this its errors (device open
	# failures, socket bind failures) are lost to /dev/null
	procd_set_param stderr 1

	procd_close_instance
}

boot()
{
	# At boot lo's ::1 address may not exist yet. gpsd binds each loopback
	# family once at startup and silently continues IPv4-only when the ::1
	# bind fails, which breaks localhost clients that try ::1 first and
	# don't fall back (gpsmon's non-blocking connect). Wait for ::1 before
	# the first start.
	if [ -f /proc/net/if_inet6 ]; then
		local n=0
		while [ "$n" -lt 10 ] &&
			! grep -q "^00000000000000000000000000000001" /proc/net/if_inet6; do
			sleep 1
			n=$((n + 1))
		done
	fi
	start "$@"
}

start_service()
{
	config_load "$NAME"
	config_foreach validate_section_gpsd gpsd gpsd_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	procd_add_validation validate_section_gpsd
}
